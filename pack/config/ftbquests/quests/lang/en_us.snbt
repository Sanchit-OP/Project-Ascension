{
	"chapter.31FD0572AE70D319.title": "First Light"
	"chapter.31FD0572AE70D319.chapter_subtitle": ["Earth. Learn the ground you stand on."]
	"quest.738C3477565410E7.title": "Open the Ledger"
	"quest.738C3477565410E7.quest_subtitle": "It keeps count, and it points"
	"quest.738C3477565410E7.quest_desc": ["This book remembers what you do and points at what to do next.", "It will say where to look. It will not say why.", "Open it any time with J. Press the button below to carry on."]
	"quest.4AF38B92DD4084D6.title": "Know your numbers"
	"quest.4AF38B92DD4084D6.quest_subtitle": "Everything you carry has them"
	"quest.4AF38B92DD4084D6.quest_desc": ["What you wear and hold changes your numbers: damage, armour, speed and more.", "Open your character sheet (H by default) to see each number and where it comes from.", "Growth (K) and runes (R) feed the same sheet."]
	"quest.1EAC31FF3592974E.title": "Dead doors"
	"quest.1EAC31FF3592974E.quest_subtitle": "Obsidian will not open them"
	"quest.1EAC31FF3592974E.quest_desc": ["The old portals are dead. Lighting an obsidian frame does nothing here.", "Other worlds are reached by air, and later by rings you wake yourself."]
	"quest.37F60931C7C6C5D2.title": "First iron"
	"quest.37F60931C7C6C5D2.quest_subtitle": "Nothing starts without it"
	"quest.37F60931C7C6C5D2.quest_desc": ["Smelt your first iron. Almost everything after this is built on it."]
	"quest.254E3200FDE479C6.title": "Diamonds"
	"quest.254E3200FDE479C6.quest_subtitle": "Deep, and worth the dark"
	"quest.254E3200FDE479C6.quest_desc": ["Titanium needs a diamond pickaxe, and the first gateway wants a handful more.", "Look near the bottom of the world. Take light, food and a bucket of water."]
	"quest.4C6D7B1AFA4FB07C.title": "Keep some gold"
	"quest.4C6D7B1AFA4FB07C.quest_subtitle": "It matters more than it looks"
	"quest.4C6D7B1AFA4FB07C.quest_desc": ["Gather four gold ingots and keep them on you, not left in a chest.", "You will be glad of them before long. Where, you will see for yourself."]
	"quest.0AC0AFA737E77E30.title": "The dark below"
	"quest.0AC0AFA737E77E30.quest_subtitle": "A city that is asleep"
	"quest.0AC0AFA737E77E30.quest_desc": ["Far under the world there is a city, and everything in it is asleep.", "It lies inside the deep dark: caves lined with sculk, near the bottom of the world.", "A cartographer who has risen past novice may sell a map to the nearest one, for 14 emeralds and a compass.", "Go quietly. Sneak, and put wool under your feet where you must cross open floor.", "Bring good armour, food and a way back up."]
	"quest.194DE687782014EC.title": "The Warden"
	"quest.194DE687782014EC.quest_subtitle": "It hears, and nothing else"
	"quest.194DE687782014EC.quest_desc": ["It cannot see you. It hears your steps, your digging and your fall.", "Wear what you can afford to lose, and know where the way up is.", "The first time your team beats it, everyone on the team gains skill points."]
	"quest.201C4FDECE7D7752.title": "A tendril"
	"quest.201C4FDECE7D7752.quest_subtitle": "A gate will want one"
	"quest.201C4FDECE7D7752.quest_desc": ["The Warden leaves a tendril behind when it falls, if a player struck the blow.", "Keep it: a gateway will not wake without one."]
	"quest.31621D31797E9687.title": "Gatestone"
	"quest.31621D31797E9687.quest_subtitle": "Carved, and veined with sculk"
	"quest.31621D31797E9687.quest_desc": ["Eight polished deepslate and one piece of sculk make eight gatestones.", "The frame takes twenty-eight. Take sculk from the dark city with Silk Touch."]
	"quest.1370C106A85089AF.title": "The keystone"
	"quest.1370C106A85089AF.quest_subtitle": "Four diamonds and a compass"
	"quest.1370C106A85089AF.quest_desc": ["Diamonds at the corners, echo shards above and below, sculk catalysts at the sides, a compass in the middle.", "It goes in the base of the ring."]
	"quest.6DD35FA2DD71D1DF.title": "Earth's gate"
	"quest.6DD35FA2DD71D1DF.quest_subtitle": "A frame of carved stone"
	"quest.6DD35FA2DD71D1DF.quest_desc": ["Build the ring on level ground from the plan beside these quests, and set the keystone in its base. The Build the Gate page walks through it.", "Use a tendril on the keystone to wake it. When it is lit, everyone on the server gains from it.", "A gate on its own has nowhere to lead yet. Look at the Planets page."]
	"quest.1348BB42A5607EA0.title": "Titanium"
	"quest.1348BB42A5607EA0.quest_subtitle": "The metal for leaving"
	"quest.1348BB42A5607EA0.quest_desc": ["Titanium ore lies in the deepest rock and needs a diamond pickaxe. Smelt the ore or the raw titanium it drops; a blast furnace is twice as fast.", "Three ingots, an iron sheet and a wooden slab make the plain propeller bearing an airship needs."]
	"quest.4121BDE2FA93BA25.title": "A breath of your own"
	"quest.4121BDE2FA93BA25.quest_subtitle": "Where the air runs out"
	"quest.4121BDE2FA93BA25.quest_desc": ["Some places have no air. Craft an oxygen tank and you carry your own.", "Your lungs hold about twenty seconds and refill wherever the air is good. A tank is drained first."]
	"quest.20022FE6B8C4E2F9.title": "The valve"
	"quest.20022FE6B8C4E2F9.quest_subtitle": "A tank only helps when it is open"
	"quest.20022FE6B8C4E2F9.quest_desc": ["Use the tank to open its valve. It takes three seconds to pressurise, and you can carry two.", "Use it on another player to share your air with them."]
	"quest.407F6003A93FC43F.title": "Look up"
	"quest.407F6003A93FC43F.quest_subtitle": "The Planets page has changed"
	"quest.407F6003A93FC43F.quest_desc": ["Open the Planets page. A world you had only heard of now has a name.", "The page also shows where you are, on the ground and between the worlds."]
	"chapter.52BAAB3373E20AD2.title": "Runes and Skill Points"
	"chapter.52BAAB3373E20AD2.chapter_subtitle": ["Two screens, one character."]
	"quest.231B9DE4FDB1282D.title": "What skill points are"
	"quest.231B9DE4FDB1282D.quest_subtitle": "Permanent, and spent on you"
	"quest.231B9DE4FDB1282D.quest_desc": ["A skill point makes you stronger for good. You earn them for firsts: never for kills or hours played, so nothing can be farmed.", "There are 41 in all. You will not fill the whole web, so choose."]
	"quest.7DBDD51CA7C31B66.title": "Points from bosses"
	"quest.7DBDD51CA7C31B66.quest_subtitle": "3 each, once, for the whole team"
	"quest.7DBDD51CA7C31B66.quest_desc": ["The first time your team beats each boss, every player on it gains 3 points.", "The Warden, the Wither, the Ender Golem, the Ender Guardian, the Netherite Monstrosity, Ignis and the Ender Dragon.", "Beating the same boss again gives nothing. A friend who joins later is given the points too."]
	"quest.3983A847E6B83CA8.title": "Points from gates"
	"quest.3983A847E6B83CA8.quest_subtitle": "2 each, once, for the whole team"
	"quest.3983A847E6B83CA8.quest_desc": ["Every gate you light gives every player 2 points: Earth's, the Moon's, the Nether's and the End's.", "A lit gate stays lit, so these come once too."]
	"quest.3A169BE756F1B40C.title": "Places and projects"
	"quest.3A169BE756F1B40C.quest_subtitle": "1 each, once"
	"quest.3A169BE756F1B40C.quest_desc": ["The first time you find each kind of place, you gain a point: a few ruins, and every new world you land on. These are yours alone.", "Each project sheet (Spin, Brass, Crude, Wings, Breath, Skyline) pays one point to the whole team when its finale is done.", "A hundred of the same kind give one point. Bosses, gates and projects are shared."]
	"quest.0FB0E7741D93E932.title": "The Skill Web"
	"quest.0FB0E7741D93E932.quest_subtitle": "K"
	"quest.0FB0E7741D93E932.quest_desc": ["Press K. A gold note above your health row tells you when you have points to spend.", "Click a node to mark it, click again to unmark, then press Confirm. Hover a node for what it gives.", "A node costs one point and must touch one you already hold, or sit in the ring round the centre."]
	"quest.429C425E53ACA485.title": "What each corner gives"
	"quest.429C425E53ACA485.quest_subtitle": "Power, Fury, Guard, Wayfarer"
	"quest.429C425E53ACA485.quest_desc": ["Power: Attack Damage, Lethality and Penetration. Fury: Attack Speed and Omnivamp.", "Guard: Health, Armor and Magic Resist. Wayfarer: Move Speed, mining speed, reach and safe falls.", "A small node is about 3% of what a geared player has: +1 Attack Damage, +3 Health or +5 Armor.", "Notables and the outer ring give several times that. The corners shade into one another, so you can drift."]
	"quest.41F78D9CDB3575A5.title": "Change your mind"
	"quest.41F78D9CDB3575A5.quest_subtitle": "Twenty levels, out of a fight"
	"quest.41F78D9CDB3575A5.quest_desc": ["The Respec button returns every point to spend again. It works anywhere out of combat and costs 20 experience levels.", "It moves points; it never makes them. Death takes nothing from the web."]
	"quest.678C04AABCCA8FC6.title": "The rune page"
	"quest.678C04AABCCA8FC6.quest_subtitle": "R"
	"quest.678C04AABCCA8FC6.quest_desc": ["Press R. Runes change how you fight, not how strong you are: skill points are numbers, runes are behaviours.", "Your page holds a main path, a second path and three stat shards. Nothing is kept until you press Save, and Reset takes you back to the page you saved."]
	"quest.3ED688C8E8F5D437.title": "Four paths"
	"quest.3ED688C8E8F5D437.quest_subtitle": "Pick how you play"
	"quest.3ED688C8E8F5D437.quest_desc": ["Vanguard keeps hitting: damage that grows the longer a fight lasts. Reaver strikes first and finishes fast.", "Aetherwright makes the magic do more. Bulwark stands in front: defence, pets and the team.", "Every rune can be tried from the first minute; only the slots are locked."]
	"quest.2C168EA9DEC4569D.title": "Keystones"
	"quest.2C168EA9DEC4569D.quest_subtitle": "The rune that sets your style"
	"quest.2C168EA9DEC4569D.quest_desc": ["Your main path gives one keystone and one small rune from each of its two rows. Each path has three keystones: two for fighting and a third that stands apart.", "The third one stands apart on the dial: vein mining, Lethality as damage, more experience, or healing that becomes a shield.", "Your second path gives two small runes and no keystone."]
	"quest.728021FC304009D2.title": "Slots that open"
	"quest.728021FC304009D2.quest_subtitle": "The page grows as you do"
	"quest.728021FC304009D2.quest_desc": ["The main path is open from the start. Your team's first boss kill or lit gate opens the second path; the next three open the offence, flex and defence shards.", "Points from places do not open slots. A locked slot says what opens it."]
	"quest.6BD7E3D3CE4837CC.title": "Changing a rune"
	"quest.6BD7E3D3CE4837CC.quest_subtitle": "One chalk and three levels"
	"quest.6BD7E3D3CE4837CC.quest_desc": ["Filling an empty slot is free. Removing or replacing a rune costs one Rune Chalk and 3 levels, once per save however many runes change, and only out of combat.", "Amethyst and calcite make chalk, and both come from geodes. Here are two to start."]
	"quest.45B9AEE58941C962.title": "Runes that grow"
	"quest.45B9AEE58941C962.quest_subtitle": "New kinds of enemy"
	"quest.45B9AEE58941C962.quest_desc": ["Four runes grow: Blooded, Trophy Hunter, Gathering Charge and Deep Roots.", "Each new kind of enemy you defeat while one is on your page adds to it, up to 20 kinds.", "A farm cannot fill it, since a zombie is one kind however many fall. Swap the rune out and it starts again."]
	"quest.5B50B1407AAF20F1.title": "Putting it together"
	"quest.5B50B1407AAF20F1.quest_subtitle": "H"
	"quest.5B50B1407AAF20F1.quest_desc": ["Gear is what you carry, skill points are who you are for good, and runes are how you fight today.", "The character sheet (H) shows all three and where every number comes from, so you can see what a node or a rune is really doing."]
	"chapter.6236D6A3D7C8AE21.title": "Build the Gate"
	"chapter.6236D6A3D7C8AE21.chapter_subtitle": ["Earth's ring, stone by stone."]
	"quest.3E49DBC5FD0D27E5.title": "Read the plan"
	"quest.3E49DBC5FD0D27E5.quest_subtitle": "A view, a key and twenty layers"
	"quest.3E49DBC5FD0D27E5.quest_desc": ["The picture beside this shows the whole ring from the front, then every layer from the ground up.", "The ring is 15 wide, 7 deep and 20 high: 418 blocks, with an opening 5 wide and 7 high that you walk through.", "Each colour is a family of blocks. Any block in a family may stand in for another."]
	"quest.17D62E6C8ADC592F.title": "Level ground"
	"quest.17D62E6C8ADC592F.quest_subtitle": "Room for the ring to stand"
	"quest.17D62E6C8ADC592F.quest_desc": ["Pick open, flat ground with room for 15 by 7 blocks and twenty of clear air above.", "The ring stands upright. The opening is in its middle, three layers up from the ground."]
	"quest.1F9723AE70DCC0E9.title": "The stone"
	"quest.1F9723AE70DCC0E9.quest_subtitle": "Five families, 389 blocks"
	"quest.1F9723AE70DCC0E9.quest_desc": ["Dark, 189: deepslate bricks or tiles, polished deepslate or blackstone, smooth basalt.", "Pale, 72: quartz blocks or bricks, smooth quartz, calcite, polished diorite. A gold block works too.", "Pillars, 46: quartz pillar, bone block or polished basalt.", "Accents, 26: chiselled stone bricks, quartz or deepslate, or a gold block.", "Steps, 56: slabs of deepslate, polished deepslate or polished blackstone."]
	"quest.3778DA6EA519166E.title": "Gatestones"
	"quest.3778DA6EA519166E.quest_subtitle": "Twenty-eight, carved"
	"quest.3778DA6EA519166E.quest_desc": ["Eight polished deepslate and a piece of sculk make eight gatestones. Take sculk with Silk Touch.", "They go round the keystone, down both sides of the opening and along the top."]
	"quest.181293014206D864.title": "The keystone"
	"quest.181293014206D864.quest_subtitle": "One block wakes the ring"
	"quest.181293014206D864.quest_desc": ["Four diamonds, two echo shards, two sculk catalysts and a compass make the keystone.", "It sits in the third layer from the ground, at the very centre of the ring."]
	"quest.69041730AFD83AF5.title": "Raise the ring"
	"quest.69041730AFD83AF5.quest_subtitle": "From the ground up"
	"quest.69041730AFD83AF5.quest_desc": ["Build from the bottom layer to the top, as the plan shows. Mix the stones of a family as you like.", "Leave the opening empty. The ring will not light if a block is wrong."]
	"quest.488C3EA1A2BDCF2E.title": "Wake it"
	"quest.488C3EA1A2BDCF2E.quest_subtitle": "A tendril on the keystone"
	"quest.488C3EA1A2BDCF2E.quest_desc": ["Use a Warden tendril on the keystone. When the opening fills, the ring is lit.", "Everyone on the server gains skill points from it. A gate on its own leads nowhere yet: see the Planets page."]
	"chapter.5B70CA1E5CE414C2.title": "Planets"
	"chapter.5B70CA1E5CE414C2.chapter_subtitle": ["Where you are, and what you have found"]
	"quest.64FEAAF9F93DFB90.title": "Earth"
	"quest.64FEAAF9F93DFB90.quest_subtitle": "Home"
	"quest.64FEAAF9F93DFB90.quest_desc": ["Where you start. Everything on this chart is measured from here.", "The marker follows you: on the ground, and between the worlds when you are in space."]
	"quest.38E2DDDB06CDA399.title": "The Moon"
	"quest.38E2DDDB06CDA399.quest_subtitle": "4,000 blocks east"
	"quest.38E2DDDB06CDA399.quest_desc": ["A pale world with no air. Reach it by airship: up past the top of the sky, then east.", "Bring a tank, and a way home.", "Something lies buried under its surface."]
	"quest.4110412AC1AE6C2E.title": "The Nether"
	"quest.4110412AC1AE6C2E.quest_subtitle": "18,000 blocks south-east"
	"quest.4110412AC1AE6C2E.quest_desc": ["A world of fire with no roof over it, far out to the south-east.", "Something in the air there harms you. Gold armour turns it away: wear it.", "Plan a long flight."]
	"quest.0ACE2D2F0C79926C.title": "The End"
	"quest.0ACE2D2F0C79926C.quest_subtitle": "32,000 blocks south"
	"quest.0ACE2D2F0C79926C.quest_desc": ["A belt of floating rock in the dark, far out to the south. Nothing holds the islands together.", "Something old guards it. Wings help.", "Plan a long flight."]
	"chapter.35D07E504E4B332F.title": "Spin"
	"chapter.35D07E504E4B332F.chapter_subtitle": ["Make the world do the turning."]
	"quest.778F5319036EB164.title": "The manual in your hand"
	"quest.778F5319036EB164.quest_subtitle": "Create explains itself"
	"quest.778F5319036EB164.quest_desc": ["Create teaches its own machines. Hold W over any Create item, in your inventory or in JEI, and a short animated guide plays.", "A ship is made of Create parts, so this is where the way up begins."]
	"quest.648F148F479CB269.title": "Andesite alloy"
	"quest.648F148F479CB269.quest_subtitle": "Where Create begins"
	"quest.648F148F479CB269.quest_desc": ["Two andesite and two iron nuggets, set on a diagonal, make one alloy.", "Shafts, cogwheels, casings and nearly every part of a ship are made from it. You will want a dozen."]
	"quest.5E1D45D61CAF85BB.title": "Casing"
	"quest.5E1D45D61CAF85BB.quest_subtitle": "A log, wrapped in alloy"
	"quest.5E1D45D61CAF85BB.quest_desc": ["Strip a log, then use andesite alloy on it. That is a casing.", "A ship's controls are built on casings: the physics assembler, the steering wheel, the sensors."]
	"quest.077125400A53E565.title": "Spinning power"
	"quest.077125400A53E565.quest_subtitle": "Water, wind or a hand crank"
	"quest.077125400A53E565.quest_desc": ["Create machines run on spinning power. A water wheel in a stream is the simplest source; a windmill or a hand crank also works.", "Hold W over each to see how it is built."]
	"quest.51560B86C08B0177.title": "Pressed iron"
	"quest.51560B86C08B0177.quest_subtitle": "Sheets for everything"
	"quest.51560B86C08B0177.quest_desc": ["A mechanical press flattens iron into sheets. It needs a casing, a shaft, an iron block and something to turn it.", "You need nine: one for the bearing, four for a propeller, four for a burner."]
	"quest.456D5B7D866D892C.title": "Shafts and cogs"
	"quest.456D5B7D866D892C.quest_subtitle": "Spin travels along them"
	"quest.456D5B7D866D892C.quest_desc": ["Two andesite alloy make eight shafts. A shaft and a plank make a cogwheel; one more plank makes it large.", "Cogs that touch turn each other, the opposite way. A large cog driving a small one makes the small one spin twice as fast."]
	"quest.1BA26DA4F2EBEE9C.title": "A hand crank"
	"quest.1BA26DA4F2EBEE9C.quest_subtitle": "Slow, and needs nothing"
	"quest.1BA26DA4F2EBEE9C.quest_desc": ["Three planks and an alloy make a crank. Hold use on it to spin whatever it is attached to.", "Good for testing a machine before you build a real source."]
	"quest.7D911B8A368729AF.title": "A water wheel"
	"quest.7D911B8A368729AF.quest_subtitle": "A stream does the work"
	"quest.7D911B8A368729AF.quest_desc": ["Eight planks round a shaft. Set it so moving water pushes its paddles.", "Eight planks round a water wheel make a large one, which gives more."]
	"quest.4A23B7107970C517.title": "A windmill"
	"quest.4A23B7107970C517.quest_subtitle": "Sails catch the wind"
	"quest.4A23B7107970C517.quest_desc": ["A windmill bearing is a slab, a stone and a shaft. It turns whatever structure you attach to its front.", "A wool, two sticks and an alloy make two sails. The more sail blocks it carries, the faster it turns."]
	"quest.279C1B352598D68D.title": "Stress"
	"quest.279C1B352598D68D.quest_subtitle": "Every machine has a price"
	"quest.279C1B352598D68D.quest_desc": ["Each machine costs stress, and each power source can give only so much. Ask for more than it has and the whole network stops.", "A speedometer is a compass over a casing; a stressometer is made from one. Goggles let you read them."]
	"quest.1A7C4EAFD1301B98.title": "Wrench and goggles"
	"quest.1A7C4EAFD1301B98.quest_subtitle": "Tune it, and see inside it"
	"quest.1A7C4EAFD1301B98.quest_desc": ["A wrench is three gold sheets, a cogwheel and a stick. Goggles are two glass, a gold sheet and string.", "The wrench turns and takes apart machines; goggles show speed, stress and what a block holds."]
	"quest.2C9B9408939AF67E.title": "Turning corners"
	"quest.2C9B9408939AF67E.quest_subtitle": "Gearboxes, clutches, gearshifts"
	"quest.2C9B9408939AF67E.quest_desc": ["A gearbox is four cogwheels round a casing: it sends spin round corners and splits it.", "A clutch (casing, shaft, redstone) cuts spin with a signal. A gearshift (casing, cogwheel, redstone) reverses it."]
	"quest.33784D5CE51D40D2.title": "Belts"
	"quest.33784D5CE51D40D2.quest_subtitle": "Link two shafts, carry what is on top"
	"quest.33784D5CE51D40D2.quest_desc": ["Six dried kelp make a belt. Use it on two shafts to join them; the belt carries items and anything standing on it."]
	"quest.525035C40110948D.title": "Steam"
	"quest.525035C40110948D.quest_subtitle": "A boiler, and a lot of power"
	"quest.525035C40110948D.quest_desc": ["A steam engine is a gold sheet, an alloy and a copper block. It sits on a fluid tank with water in it.", "The tank needs heat under it, and a lit burner does that (the Brass page makes one). Hold W over the engine for the rest."]
	"quest.31F7D08D8D723EF6.title": "A millstone"
	"quest.31F7D08D8D723EF6.quest_subtitle": "Ore to crushed ore, grain to flour"
	"quest.31F7D08D8D723EF6.quest_desc": ["A cogwheel over a casing over a stone. Drop items on top while it turns and they come out ground.", "Crushed ore can be smelted, or washed into nuggets at a fan."]
	"quest.25BCAADEC1250707.title": "A saw"
	"quest.25BCAADEC1250707.quest_subtitle": "Logs to planks, and more"
	"quest.25BCAADEC1250707.quest_desc": ["Three iron sheets, an iron ingot and a casing. Stood upright, it cuts whatever you put on it.", "Turned to face a tree, it fells it."]
	"quest.681459E09FA0993E.title": "An encased fan"
	"quest.681459E09FA0993E.quest_subtitle": "Moves air, and what rides on it"
	"quest.681459E09FA0993E.quest_desc": ["A shaft over a casing over a propeller. It blows air one way when it spins one way, and sucks the other way when reversed."]
	"quest.389FFCFA329129D6.title": "What the air passes through"
	"quest.389FFCFA329129D6.quest_subtitle": "Wash, smoke, blast, haunt"
	"quest.389FFCFA329129D6.quest_desc": ["Items carried by a fan are changed by what its air passes through. Water washes, fire smokes, lava blasts and soul fire haunts.", "Put the block in front of the fan, with the items between.", "Soul fire burns only on soul sand or soul soil, and Earth has little of either, so here is one block to light it on."]
	"quest.58271DC5E963B5AB.title": "A basin"
	"quest.58271DC5E963B5AB.quest_subtitle": "A bowl for machines to work on"
	"quest.58271DC5E963B5AB.quest_desc": ["Five andesite alloy in a bowl shape. Machines above it work on what it holds."]
	"quest.6AFCA0A066B96E1F.title": "A mixer"
	"quest.6AFCA0A066B96E1F.quest_subtitle": "Combine ingredients"
	"quest.6AFCA0A066B96E1F.quest_desc": ["A cogwheel over a casing over a whisk. Set it over a basin and turn it.", "Some mixes need heat: a lit burner under the basin gives it. The Brass page shows how to make one."]
	"quest.5188ABFFFDCD7AF8.title": "Compacting"
	"quest.5188ABFFFDCD7AF8.quest_subtitle": "Fewer items from more"
	"quest.5188ABFFFDCD7AF8.quest_desc": ["Set a mechanical press over a basin and it squeezes what the basin holds into something denser."]
	"quest.035D40066F6B68BA.title": "Copper casing"
	"quest.035D40066F6B68BA.quest_subtitle": "A log, wrapped in copper"
	"quest.035D40066F6B68BA.quest_desc": ["Use a copper ingot on a stripped log. The spout and the item drain are built on copper casings."]
	"quest.1413DFAA81D343E1.title": "Chutes"
	"quest.1413DFAA81D343E1.quest_subtitle": "Items, straight down"
	"quest.1413DFAA81D343E1.quest_desc": ["Two iron sheets and an iron ingot make four. Items fall down a chute; a fan under it can blow them up."]
	"quest.4688718CB2F09B64.title": "Funnels"
	"quest.4688718CB2F09B64.quest_subtitle": "Into a chest, or out of one"
	"quest.4688718CB2F09B64.quest_desc": ["An alloy over dried kelp makes two. A funnel takes items out of a container, or puts them in. Hold W over it for how it faces."]
	"quest.675737843FA5B0A6.title": "Pipes and a pump"
	"quest.675737843FA5B0A6.quest_subtitle": "Moving fluid"
	"quest.675737843FA5B0A6.quest_desc": ["Two copper sheets and a copper ingot make four pipes. A cogwheel and a pipe make a pump, which pushes fluid one way as it spins.", "A fluid tank is a barrel between two copper sheets."]
	"quest.4EF8B9F90325851D.title": "A spout"
	"quest.4EF8B9F90325851D.quest_subtitle": "Fill what passes under it"
	"quest.4EF8B9F90325851D.quest_desc": ["A copper casing over dried kelp. Set it over a belt or a depot and it fills buckets, bottles and the like from the pipe it is joined to."]
	"quest.24B30AE1B5F8827E.title": "A working line"
	"quest.24B30AE1B5F8827E.quest_subtitle": "Press, mixer, fan, belt and spout"
	"quest.24B30AE1B5F8827E.quest_desc": ["A press that flattens, a mixer that stirs, a fan that washes and smokes, a belt that carries, a spout that fills.", "With all of them turning off one shaft, a base builds itself while you are away."]
	"chapter.57E1D441ADB1F68F.title": "Brass"
	"chapter.57E1D441ADB1F68F.chapter_subtitle": ["Fire, metal and a hand that works for you."]
	"quest.21D9B7848ED84479.title": "A burner for the basin"
	"quest.21D9B7848ED84479.quest_subtitle": "With a blaze, or without one"
	"quest.21D9B7848ED84479.quest_desc": ["Heated recipes need a blaze burner under the basin. A captured blaze makes one: use an empty burner on a blaze, in the Nether.", "You can make the same burner at home: iron sheets round a magma block, a lava bucket on top. Feed it coal to light it."]
	"quest.04BF3DEDB6B04093.title": "Brass"
	"quest.04BF3DEDB6B04093.quest_subtitle": "Create's next tier"
	"quest.04BF3DEDB6B04093.quest_desc": ["Copper and zinc, mixed over a lit burner, make brass. Three of each make two ingots by hand at a crafting table, dearer than the mixer.", "Brass is the upgrade: stronger casings, finer controls, better propellers."]
	"quest.39C750A73A2D005D.title": "A deployer"
	"quest.39C750A73A2D005D.quest_subtitle": "Your own hands, on a machine"
	"quest.39C750A73A2D005D.quest_desc": ["An electron tube over a casing over a brass hand. It uses items on blocks, places blocks, and presses buttons.", "The brass hand is four brass sheets and an alloy. The electron tube has its own quest."]
	"quest.0482E37944A9D9FC.title": "Mechanical crafters"
	"quest.0482E37944A9D9FC.quest_subtitle": "Crafting without hands"
	"quest.0482E37944A9D9FC.quest_desc": ["An electron tube, a brass casing and a crafting table make three. Set them in a grid and they craft together."]
	"quest.750221738B454389.title": "Crushing wheels"
	"quest.750221738B454389.quest_subtitle": "A pair, set side by side"
	"quest.750221738B454389.quest_desc": ["Crushing wheels are made two at a time at mechanical crafters, so they come after brass.", "Items that fall between a spinning pair are ground, faster than a millstone does it."]
	"quest.13A40786829CBFDD.title": "A precision mechanism"
	"quest.13A40786829CBFDD.quest_subtitle": "Built in loops"
	"quest.13A40786829CBFDD.quest_desc": ["A gold sheet is passed along a line of machines, round and round, until it becomes a mechanism.", "Fine parts like this are made by passing one item through many machines. Hold W over it."]
	"quest.4CF95F61BD4815E1.title": "An electron tube"
	"quest.4CF95F61BD4815E1.quest_subtitle": "A shard of light, bound in iron"
	"quest.4CF95F61BD4815E1.quest_desc": ["A deployer, a crafter and every fine control start with an electron tube. Create cuts it from rose quartz: quartz and eight redstone, polished with sandpaper.", "Quartz is not only in the Nether. A crushing wheel gets it from diorite, and a fan's water gets it from crushed raw gold or from soul sand."]
	"chapter.1C966D794046C9BC.title": "Current"
	"chapter.1C966D794046C9BC.chapter_subtitle": ["Spin becomes power, and power keeps."]
	"quest.368C3C931F9D23EC.title": "Power aboard"
	"quest.368C3C931F9D23EC.quest_subtitle": "Electricity, stored in the hull"
	"quest.368C3C931F9D23EC.quest_desc": ["Create Crafts & Additions turns spin into electricity and electricity back into spin. Wires carry it, accumulators store it.", "A ship can carry its own power: with the Sable addon the wires follow the ship, so a charged accumulator in the hull runs anything on board."]
	"quest.71B4C0A0F533625A.title": "An alternator"
	"quest.71B4C0A0F533625A.quest_subtitle": "Spin in, power out"
	"quest.71B4C0A0F533625A.quest_desc": ["Andesite alloy, iron plates, an iron rod and copper spools, on a mechanical crafter. A shaft turns it and it gives energy to whatever is wired to it."]
	"quest.1B176CEB14C0F95A.title": "An accumulator"
	"quest.1B176CEB14C0F95A.quest_subtitle": "Power kept for later"
	"quest.1B176CEB14C0F95A.quest_desc": ["A brass casing, two capacitors, a copper rod and electrum wire. Connect it to a generator, and it feeds machines when the generator is stopped."]
	"quest.28807E809AAEA335.title": "Wires"
	"quest.28807E809AAEA335.quest_subtitle": "Power travels along copper"
	"quest.28807E809AAEA335.quest_desc": ["A connector on each end and a copper wire between them carry power across a base.", "With the Sable addon the wire stays joined when the ship moves, so a ship can have its own wiring."]
	"quest.3222771C8671BD90.title": "An electric motor"
	"quest.3222771C8671BD90.quest_subtitle": "Power back into spin"
	"quest.3222771C8671BD90.quest_desc": ["The alternator turns spin into power; the electric motor does the opposite. Power kept in an accumulator can turn a shaft again.", "A motor is a quiet way to turn a propeller: no fuel, no smoke."]
	"chapter.26898F5F6C018C35.title": "Crude"
	"chapter.26898F5F6C018C35.chapter_subtitle": ["Oil out of the ground, fuel out of the oil."]
	"quest.7DA25AAA70667BA1.title": "Oil for the rocket"
	"quest.7DA25AAA70667BA1.quest_subtitle": "Out of the ground, into a tank"
	"quest.7DA25AAA70667BA1.quest_desc": ["The liquid Thruster burns kerosene, diesel or gasoline. All three come out of crude oil, and Create: Petrochem makes the whole chain.", "Oil lies under deserts, swamps, jungles and deep oceans of Earth, and nowhere else. Every step from steel to the tower wants a burner."]
	"quest.3852382A0293C75B.title": "Steel"
	"quest.3852382A0293C75B.quest_subtitle": "Iron and coal, heated"
	"quest.3852382A0293C75B.quest_desc": ["Every Petrochem machine is made of steel. Heat an iron ingot and a coal in a mixer over a burner, then press the ingot flat for sheets.", "Pipes, tanks and plates are all steel."]
	"quest.48EAEECF93D9FE3F.title": "A pumpjack"
	"quest.48EAEECF93D9FE3F.quest_subtitle": "A crank, a well and an arm"
	"quest.48EAEECF93D9FE3F.quest_desc": ["The crank takes a rotation speed controller, the well is steel pipe, the arm is built on a mechanical crafter. Put the well in the ground, turn the crank.", "Desert and deep ocean give crude petroleum; swamp and jungle give oil that is already desalted. Any other ground gives nothing."]
	"quest.15D49FC4F1F6B894.title": "An electrolyzer"
	"quest.15D49FC4F1F6B894.quest_subtitle": "Take the salt out"
	"quest.15D49FC4F1F6B894.quest_desc": ["A mixer that runs on electricity, not spin. Wire it to an alternator or an accumulator and feed it petroleum: out come desalted oil and, half the time, salt."]
	"quest.78635FFB29DF1F07.title": "A distillation tower"
	"quest.78635FFB29DF1F07.quest_subtitle": "Split the oil by how hot it boils"
	"quest.78635FFB29DF1F07.quest_desc": ["Steel tanks stacked over a controller, a blaze burner under it, and an output block at each height. Three modes: flash, atmospheric and vacuum.", "The atmospheric mode gives diesel, kerosene and heavy naphtha. Pipe the kerosene away to a tank."]
	"quest.2305DD03FECDD14D.title": "Kerosene"
	"quest.2305DD03FECDD14D.quest_subtitle": "Fuel for a long climb"
	"quest.2305DD03FECDD14D.quest_desc": ["Kerosene gives the liquid Thruster more push for less fuel than diesel does. Gasoline pushes hardest and burns faster."]
	"quest.158F2CDB69ED0191.title": "Bronze"
	"quest.158F2CDB69ED0191.quest_subtitle": "Copper and tin, heated"
	"quest.158F2CDB69ED0191.quest_desc": ["The tower and the engines use bronze plates. Heat a copper ingot and a tin nugget in a mixer over a burner, then press the ingot.", "Tin has no ore here. Petrochem fills a zinc nugget with a thick potion; two zinc nuggets and an iron nugget make one at a crafting table."]
	"quest.44401010A72450E0.title": "A bigger tank"
	"quest.44401010A72450E0.quest_subtitle": "Platinum holds twice the fuel"
	"quest.44401010A72450E0.quest_desc": ["Platinum is Create Propulsion's own metal, in stone and deepslate. A platinum fluid tank holds twice what a copper one does.", "A good place for kerosene: a rocket burns a lot of it."]
	"chapter.0FFBABDCB1630CF5.title": "Wings"
	"chapter.0FFBABDCB1630CF5.chapter_subtitle": ["A ship that flies, steers and has a fire in it."]
	"quest.0D3E3051194A3A30.title": "A ship is a contraption"
	"quest.0D3E3051194A3A30.quest_subtitle": "Glued blocks, one moving body"
	"quest.0D3E3051194A3A30.quest_desc": ["A physics assembler is a lever on a casing between two alloy. It turns a glued group of blocks into one moving body.", "Glue what should move, then hold use on the assembler and pull its lever. Any assembler can take the ship apart again."]
	"quest.4C445100221F7173.title": "Glue"
	"quest.4C445100221F7173.quest_subtitle": "What is glued moves together"
	"quest.4C445100221F7173.quest_desc": ["Two slimeballs, an iron sheet and an iron nugget make super glue. Click two corners to glue the blocks between them.", "Honey glue (an iron sheet filled with honey at a spout) is the kind made for ships: it joins only ships."]
	"quest.139B2FC92DB94419.title": "Weight"
	"quest.139B2FC92DB94419.quest_subtitle": "Lift and thrust must beat it"
	"quest.139B2FC92DB94419.quest_desc": ["Every block has weight. A ship rises only when its lift and thrust beat the total, so build light where you can.", "A few blocks are light, super heavy, slippery or fragile. Hold W over the assembler for the list."]
	"quest.101188888DD7BFDA.title": "A balloon"
	"quest.101188888DD7BFDA.quest_subtitle": "A shell that holds hot air"
	"quest.101188888DD7BFDA.quest_desc": ["Two wool and two sticks make four envelope blocks. Enclose a space with them: hot air must be held by airtight blocks.", "Encase a shaft with an envelope block to pass it through the wall. Blocks inside use up room, and dye paints them."]
	"quest.3472B710D903A6D7.title": "The hot air burner"
	"quest.3472B710D903A6D7.quest_subtitle": "It fills the balloon above it"
	"quest.3472B710D903A6D7.quest_desc": ["Four iron sheets, two alloy, redstone and a coal block. Power it with redstone and it fills the balloon above.", "A panel sets the most hot air it may give, and the signal strength scales that. Several burners can share a balloon."]
	"quest.7550C8791F5A44BF.title": "The bearing"
	"quest.7550C8791F5A44BF.quest_subtitle": "Titanium turns the blades"
	"quest.7550C8791F5A44BF.quest_desc": ["Three titanium ingots, an iron sheet and a wooden slab make the bearing that spins a propeller.", "The usual recipe asks for brass. Here, titanium does the job."]
	"quest.49C3BADD29599892.title": "Propellers"
	"quest.49C3BADD29599892.quest_subtitle": "Sails on a bearing"
	"quest.49C3BADD29599892.quest_desc": ["A propeller bearing attaches to the block in front of it. Anything with at least two sail-like blocks counts as a propeller; more sails push harder.", "Reversing the spin, or using a wrench, reverses the push. A propeller moving through air pushes less."]
	"quest.0336D33F956E38E2.title": "A portable engine"
	"quest.0336D33F956E38E2.quest_subtitle": "The ship carries its own power"
	"quest.0336D33F956E38E2.quest_desc": ["A blast furnace, an engine assembly and an iron sheet make one. It burns fuel to turn a shaft, wherever it is.", "Fuel goes in by hand or by machine. A blaze cake superheats it for more power."]
	"quest.0FFB162AEE1FB4B4.title": "A helm"
	"quest.0FFB162AEE1FB4B4.quest_subtitle": "One block wakes the hull"
	"quest.0FFB162AEE1FB4B4.quest_desc": ["The physics assembler turns the blocks you built into one moving ship. The steering wheel turns it.", "Both are made on casings. Place the assembler where the hull begins and hold W over it."]
	"quest.092F22E898F4606B.title": "The steering wheel"
	"quest.092F22E898F4606B.quest_subtitle": "Grab it and turn"
	"quest.092F22E898F4606B.quest_desc": ["A large cogwheel over a casing over a shaft. Hold use to grab it and move the mouse to turn it; sneaking snaps it to 45 degrees.", "A bearing driven by the wheel must be told not to take the ship apart when it turns."]
	"quest.105865584B67F2B0.title": "A swivel bearing"
	"quest.105865584B67F2B0.quest_subtitle": "A part of the ship that turns"
	"quest.105865584B67F2B0.quest_desc": ["A slab over an industrial iron block over a cogwheel. It attaches to the block in front and, when powered through the cog, assembles the glued blocks there.", "Spin passes straight through along its shaft, so the turning part can be driven from the hull."]
	"quest.0F31CE97C32477DA.title": "Something to hold"
	"quest.0F31CE97C32477DA.quest_subtitle": "Handles keep you on board"
	"quest.0F31CE97C32477DA.quest_desc": ["An iron nugget over an alloy makes a handle. Grab one and you stay put while the ship moves, and a fall can be broken by catching one."]
	"quest.5E9CC76BEBA994D5.title": "A name"
	"quest.5E9CC76BEBA994D5.quest_subtitle": "Every ship has one"
	"quest.5E9CC76BEBA994D5.quest_desc": ["Paper, a stick and an alloy make four nameplates. Name your ship with one."]
	"quest.1AA1B3155D4F8627.title": "A propeller that tips itself"
	"quest.1AA1B3155D4F8627.quest_subtitle": "Brass, and a little quartz"
	"quest.1AA1B3155D4F8627.quest_desc": ["A smart propeller makes thrust when spun and tips itself to face upward.", "It needs brass and quartz. Hold W over it in JEI to see the rest."]
	"quest.7CAF54B976C4D1D8.title": "A throttle lever"
	"quest.7CAF54B976C4D1D8.quest_subtitle": "Set a signal by hand"
	"quest.7CAF54B976C4D1D8.quest_desc": ["A stick on a brass casing. Drag it to set a signal from nothing to full, and use a wrench to invert it."]
	"quest.267C2E5B0F74C7D0.title": "A gimbal sensor"
	"quest.267C2E5B0F74C7D0.quest_subtitle": "A signal that follows the tilt"
	"quest.267C2E5B0F74C7D0.quest_desc": ["A compass over a gyroscopic mechanism over a brass casing. It gives a signal by tilt, each axis on its own.", "By default the signal is strongest downhill; you can set the angle and invert it."]
	"quest.0008F7A2299413E7.title": "Steering a ship"
	"quest.0008F7A2299413E7.quest_subtitle": "Keep it level, point it where you go"
	"quest.0008F7A2299413E7.quest_desc": ["A ship turns on three axes and wants to roll over. Two blocks make it calm: a gyroscope keeps it level, and a control stand holds the levers.", "Both come from Create: Aeroworks. They send signals over redstone links, so the stand can sit anywhere on the ship."]
	"quest.5F82319C14AF12E1.title": "A gyroscope"
	"quest.5F82319C14AF12E1.quest_subtitle": "A ship that stays level"
	"quest.5F82319C14AF12E1.quest_desc": ["A flywheel and a gimbal sensor, nothing else. Spin it with a shaft: the faster it spins, the harder it pushes the ship upright.", "Its tooltip says Off, Unstable, Steady or Level. A redstone signal on one side eases that axis, so you can tilt and then come back to level."]
	"quest.47733B7CC0022ED5.title": "A control stand"
	"quest.47733B7CC0022ED5.quest_subtitle": "Levers, a joystick, a wheel"
	"quest.47733B7CC0022ED5.quest_desc": ["A copper casing, a redstone link, a transmitter, an electron tube and a precision mechanism.", "Click modules onto it: a lever, a joystick, a wheel, a yoke, a throttle.", "Each module sends its own signal on the link frequencies you set. Wire the signals to your thrusters and propellers and you have a cockpit."]
	"quest.1BDE03F9CDA7B3B0.title": "A joystick"
	"quest.1BDE03F9CDA7B3B0.quest_subtitle": "Two axes, one hand"
	"quest.1BDE03F9CDA7B3B0.quest_desc": ["Brass, a redstone link, a precision mechanism and a shaft, built on a mechanical crafter. Push it and it signals 0 to 15 in each direction.", "It has a keyboard mode for steering without the mouse, and a button that locks it where it is."]
	"quest.52C066015E7F0C3E.title": "Thrusters"
	"quest.52C066015E7F0C3E.quest_subtitle": "A block that pushes"
	"quest.52C066015E7F0C3E.quest_desc": ["A propeller pushes against air. A thruster is a block that pushes along the way it faces, in air or out of it.", "Create Propulsion adds several: one that burns solid fuel, one that burns a liquid, and an ion thruster that runs on electricity."]
	"quest.689B936CDFED01AB.title": "A solid fuel thruster"
	"quest.689B936CDFED01AB.quest_subtitle": "Coal in, push out"
	"quest.689B936CDFED01AB.quest_desc": ["Copper sheets, iron sheets, andesite alloy, a chute and a fluid pipe: no Nether needed. It burns what you feed it and costs no stress.", "Drop fuel in from a chute or a belt. A redstone signal pauses it and stops it using fuel."]
	"quest.4E1D1D205D57F9D7.title": "Fuel decides the push"
	"quest.4E1D1D205D57F9D7.quest_subtitle": "Wood, coal, cake, helium"
	"quest.4E1D1D205D57F9D7.quest_desc": ["Wood pushes a little, coal and charcoal push more, a blaze cake pushes hardest of the common fuels.", "Raw helium from the Moon pushes like a blaze cake and burns twice as long. Bring a stack.", "Kerosene from crude oil is the liquid Thruster's best: more push for less fuel. The Crude page makes it."]
	"quest.6EFB65203626CF07.title": "A thruster"
	"quest.6EFB65203626CF07.quest_subtitle": "A liquid in, a hard push out"
	"quest.6EFB65203626CF07.quest_desc": ["Iron and copper sheets, a fluid pipe, two mechanical pumps and a brass casing. It takes a liquid fuel from a pipe or a tank: kerosene, diesel or gasoline.", "Brass can be crafted by hand from copper and zinc; a heated mixer makes it far cheaper."]
	"quest.5CA14F7691533EF9.title": "An ion thruster"
	"quest.5CA14F7691533EF9.quest_subtitle": "No fuel, only power"
	"quest.5CA14F7691533EF9.quest_desc": ["Needs redstone parts from Simulated, brass and sturdy sheets, a precision mechanism and a chute. It pushes gently for as long as it has power.", "It never runs dry, so it is what a ship uses to keep station in space."]
	"quest.272ABB61913682E8.title": "A ship that obeys"
	"quest.272ABB61913682E8.quest_subtitle": "Level, steered and fuelled"
	"quest.272ABB61913682E8.quest_desc": ["A gyroscope to keep it level, a stand to steer from, thrusters that answer. This is the ship the Moon is reached in.", "Take it up a little and bring it back before the long climb: the Skyline page says how."]
	"chapter.5D61733C5A640819.title": "Breath"
	"chapter.5D61733C5A640819.chapter_subtitle": ["Air to carry, air to make, air to keep."]
	"quest.7CB0E909964F2247.title": "A machine that makes air"
	"quest.7CB0E909964F2247.quest_subtitle": "Spin it, and it breathes out"
	"quest.7CB0E909964F2247.quest_desc": ["An air compressor turns a spinning shaft into air. The faster it spins, the more air it makes.", "Use a tank on it to fill the tank. Fill every tank before you leave: in space nothing makes air."]
	"quest.5C38EACEAEF810ED.title": "How far can you go?"
	"quest.5C38EACEAEF810ED.quest_subtitle": "Count minutes of air"
	"quest.5C38EACEAEF810ED.quest_desc": ["Space is airless. A tank lasts five minutes and you can carry two, plus twenty seconds in your lungs.", "Work out your ship's speed, then plan the trip in minutes, not blocks."]
	"quest.69695F363B61AE01.title": "A room of air"
	"quest.69695F363B61AE01.quest_subtitle": "Seal it, and it fills"
	"quest.69695F363B61AE01.quest_desc": ["An air dispenser keeps a sealed room breathable while it has air. Pipe air to it from a compressor and a tank.", "Any hole lets the air out, so seal every gap. A bigger room needs more air every second."]
	"quest.67DC4C52B973930B.title": "A bigger breath"
	"quest.67DC4C52B973930B.quest_subtitle": "The helium tank holds twice as much"
	"quest.67DC4C52B973930B.quest_desc": ["A helium tank holds twice the air of a plain one. Fill it at the compressor the same way.", "Two helium tanks last twice as long as two plain ones, and the trip to the next world is a long one."]
	"quest.75DAAD4062BD1FCD.title": "What holds air"
	"quest.75DAAD4062BD1FCD.quest_subtitle": "Walls, doors, slabs and panes"
	"quest.75DAAD4062BD1FCD.quest_desc": ["A closed room holds air if every side is a wall. Full blocks, shut doors and trapdoors, slabs and glass panes all hold it.", "Stairs, iron bars, fences and an open door let it out. A hot air balloon's burner and envelope hold it too."]
	"chapter.79EB03B3CE31A19B.title": "Skyline"
	"chapter.79EB03B3CE31A19B.chapter_subtitle": ["Read the sky, test the ship, leave."]
	"quest.062AFA714E6E51FF.title": "Air pressure"
	"quest.062AFA714E6E51FF.quest_subtitle": "Climb, and everything weakens"
	"quest.062AFA714E6E51FF.quest_desc": ["Hot air burners lift less and propellers push less the higher you go, because the air thins.", "An altitude sensor shows your height, and with goggles on, the air pressure too."]
	"quest.6D3E9CD8CBD31E01.title": "The altitude sensor"
	"quest.6D3E9CD8CBD31E01.quest_subtitle": "A signal that follows your height"
	"quest.6D3E9CD8CBD31E01.quest_desc": ["Paper over an iron sheet over a casing. Climbing raises its signal by default, and you can set the lowest and highest heights, or invert it."]
	"quest.64302D6A1B17CC5D.title": "The velocity sensor"
	"quest.64302D6A1B17CC5D.quest_subtitle": "A signal that follows your speed"
	"quest.64302D6A1B17CC5D.quest_desc": ["A propeller over a barrel over a casing. It gives a signal by speed along the way it faces; set the speed that gives full strength."]
	"quest.2CF4F64AB697E399.title": "Aviator's goggles"
	"quest.2CF4F64AB697E399.quest_subtitle": "A pilot sees more"
	"quest.2CF4F64AB697E399.quest_desc": ["Leather and a pair of goggles. They show what engineer's goggles show: speed, stress and what a block holds."]
	"quest.059C346EDD68A171.title": "A navigation table"
	"quest.059C346EDD68A171.quest_subtitle": "A signal toward where you are going"
	"quest.059C346EDD68A171.quest_desc": ["A brass sheet over a precision mechanism over a brass casing. Give it a navigation item and it signals toward the destination, weaker when you do not face it."]
	"quest.61A35FA99BC1225C.title": "Thin air"
	"quest.61A35FA99BC1225C.quest_subtitle": "Both lift and thrust fade as you climb"
	"quest.61A35FA99BC1225C.quest_desc": ["Balloons and propellers push against air, and the air thins as you rise. By the top of the sky about a third is left.", "The sky ends at height 320. Past it, the world lets go. Build with more lift and more blades than seems fair."]
	"quest.2ED2CC995D088901.title": "Where the sky ends"
	"quest.2ED2CC995D088901.quest_subtitle": "Past the top, space begins"
	"quest.2ED2CC995D088901.quest_desc": ["Climb past the top of the sky in your ship and the world lets go. This is space, and it is empty.", "On foot you will get nowhere: only a ship can carry you past the top.", "Take two tanks. There is nothing to breathe."]
	"quest.21A66F90EF163BE8.title": "A first hop"
	"quest.21A66F90EF163BE8.quest_subtitle": "Up a little, and back down"
	"quest.21A66F90EF163BE8.quest_desc": ["Before the long climb, take the ship up a few hundred blocks and bring it back. Watch the altitude sensor and the fuel.", "Mend what you saw: a ship that drifts, a burner that runs dry, a tank that was nearly empty. Then go."]
	"chapter.119239C740926134.title": "The Moon"
	"chapter.119239C740926134.chapter_subtitle": ["Four thousand blocks east, and no air."]
	"quest.5FABAE7A6489ABA1.title": "Steer by the chart"
	"quest.5FABAE7A6489ABA1.quest_subtitle": "The Planets page follows you"
	"quest.5FABAE7A6489ABA1.quest_desc": ["Open the Planets page. A point shows where you are, with an arrow for the way you face.", "Worlds you know are named. Keep the arrow pointed at one and fly."]
	"quest.4DE0EFD601D00710.title": "Coming down"
	"quest.4DE0EFD601D00710.quest_subtitle": "A world will take your ship"
	"quest.4DE0EFD601D00710.quest_desc": ["Fly near a world and your ship is carried down to it, crew and all.", "The first lies east of Earth, about four thousand blocks out."]
	"quest.167E54E270783F56.title": "A rocket"
	"quest.167E54E270783F56.quest_subtitle": "Thrusters under a hull"
	"quest.167E54E270783F56.quest_desc": ["A rocket is a ship with its thrusters at the bottom, pointing down, and fuel in each. Glue it, assemble it, fuel it, then give the thrusters a signal.", "Put a gyroscope in the hull and a joystick at the stand, and it will climb straight. Past the top of the sky it is carried into space like any ship. Take air."]
	"quest.2596935EA8C47E7E.title": "Before you go"
	"quest.2596935EA8C47E7E.quest_subtitle": "Pack for a world with no air"
	"quest.2596935EA8C47E7E.quest_desc": ["Two tanks, full. Food, a pickaxe and light. Spare iron for more tanks.", "Fly east from Earth. When your ship nears the Moon it is carried down to the surface."]
	"quest.5C3D3D153AB786FA.title": "Touchdown"
	"quest.5C3D3D153AB786FA.quest_subtitle": "The first step is a long one"
	"quest.5C3D3D153AB786FA.quest_desc": ["Open a tank's valve before anything else. It takes three seconds to pressurise.", "Landing here earns a skill point, once."]
	"quest.297D57BAB99EB146.title": "No air"
	"quest.297D57BAB99EB146.quest_subtitle": "Lungs, tanks and a room"
	"quest.297D57BAB99EB146.quest_desc": ["Everything outside a sealed room is airless. Your lungs hold twenty seconds; a tank, five minutes.", "Build a room, seal it and put an air dispenser in it, fed with air by pipes. Fill your tanks at a compressor."]
	"quest.39210A7B5E81204C.title": "Dust"
	"quest.39210A7B5E81204C.quest_subtitle": "When you can see a dozen blocks"
	"quest.39210A7B5E81204C.quest_desc": ["Dust storms roll through now and then, and sight drops to about a dozen blocks.", "They pass in about a minute. Stop, dig in or wait; do not wander blind."]
	"quest.722D0E4EC6A99645.title": "Home in the sky"
	"quest.722D0E4EC6A99645.quest_subtitle": "It does not move"
	"quest.722D0E4EC6A99645.quest_desc": ["Earth hangs in the sky and stays where it is.", "Use it to find your way back to where you came down."]
	"quest.2E6543415E341650.title": "The Lunar Archive"
	"quest.2E6543415E341650.quest_subtitle": "A hall under the ground"
	"quest.2E6543415E341650.quest_desc": ["Under the surface, at about -160, -256, with a tall pylon over it. The Moon's middle is 0, 0.", "A great hall of things to read. Bring light, and take your time."]
	"quest.466ABCF1B5C89196.title": "Moon stone"
	"quest.466ABCF1B5C89196.quest_subtitle": "It builds rings, and looks the part"
	"quest.466ABCF1B5C89196.quest_desc": ["Anorthosite and lunar basalt both build gateway frames; every kind of frame block accepts them.", "Haul some home: a ring of Moon stone matches the one waiting here."]
	"quest.29A74F9C723843DD.title": "Tall visitors"
	"quest.29A74F9C723843DD.quest_subtitle": "Do not meet their eyes"
	"quest.29A74F9C723843DD.quest_desc": ["The Moon's Endermen are taller and older than Earth's. Looking at one is an invitation.", "A carved pumpkin on your head hides your eyes from them."]
	"quest.0B06D6440EF28094.title": "The Ruined Citadel"
	"quest.0B06D6440EF28094.quest_subtitle": "A broken fortress to the east"
	"quest.0B06D6440EF28094.quest_desc": ["About eight hundred blocks east of the Moon's middle, at 800, 0. Two things guard it.", "Bring the best armour you have, food, and a way home."]
	"quest.569547F61537E838.title": "The Ender Golem"
	"quest.569547F61537E838.quest_subtitle": "A huge guardian"
	"quest.569547F61537E838.quest_desc": ["Keep moving, and fight where you have room. It is tougher here than anywhere else it is found.", "The first time your team beats it, everyone on the team gains skill points."]
	"quest.5220A441989488BD.title": "The ring on the plain"
	"quest.5220A441989488BD.quest_subtitle": "Dark, and it will not break"
	"quest.5220A441989488BD.quest_desc": ["On the plain, about a hundred and sixty blocks west of the Moon's middle, at -160, 0, a ring of pale stone stands dark.", "It cannot be broken, and it will not wake without a key."]
	"quest.28A5D61491BF79D5.title": "The Ender Guardian"
	"quest.28A5D61491BF79D5.quest_subtitle": "When the first falls, it wakes"
	"quest.28A5D61491BF79D5.quest_desc": ["It rises when the golem falls, and it drops a gateway key.", "Take the key. It fits the Moon's ring and nothing else."]
	"quest.7A22FAD6FD73A041.title": "Wake the ring"
	"quest.7A22FAD6FD73A041.quest_subtitle": "Key to the keystone"
	"quest.7A22FAD6FD73A041.quest_desc": ["Use the key on the keystone at the ring's foot. When it lights, everyone on the server gains skill points.", "Watch your hand."]
	"quest.110AEBAD91F0BDF5.title": "Two rings"
	"quest.110AEBAD91F0BDF5.quest_subtitle": "The way home, and the way back"
	"quest.110AEBAD91F0BDF5.quest_desc": ["With Earth's ring and the Moon's both lit, stepping into either offers the other.", "Ships are still how you reach worlds that have no lit ring."]
	"quest.2D0C3B663FFEF051.title": "Look out"
	"quest.2D0C3B663FFEF051.quest_subtitle": "Another world is named"
	"quest.2D0C3B663FFEF051.quest_desc": ["Open the Planets page. Another world is named, and it is far.", "The Rot page says what to bring."]
	"chapter.10B8BC825CD966BD.title": "The Rot"
	"chapter.10B8BC825CD966BD.chapter_subtitle": ["Far to the south-east. Wear gold."]
	"quest.0F23110ACAED0FB7.title": "Wear gold"
	"quest.0F23110ACAED0FB7.quest_subtitle": "This is what the gold was for"
	"quest.0F23110ACAED0FB7.quest_desc": ["The air of the Nether harms you. A single piece of gold armour, worn in any slot, keeps it off.", "Four ingots make boots, and you kept four. Netherite armour counts too, and gold calms piglins."]
	"quest.0C182BF32B0A65C1.title": "A long flight"
	"quest.0C182BF32B0A65C1.quest_subtitle": "Eighteen thousand blocks, south-east"
	"quest.0C182BF32B0A65C1.quest_desc": ["The Nether lies about eighteen thousand blocks south-east of Earth. Count the trip in minutes of air: a tank is five minutes and you can carry two.", "Light a ring there and you need not fly back."]
	"quest.15259A25C4DAE739.title": "Landing on the Nether"
	"quest.15259A25C4DAE739.quest_subtitle": "No roof, and a floor of fire"
	"quest.15259A25C4DAE739.quest_desc": ["The sky is open here, and the ground is lava seas, cliffs and caves.", "Wear your gold. Landing earns a skill point, once."]
	"quest.7C1C09F41D6FFF4C.title": "Oh, shiny"
	"quest.7C1C09F41D6FFF4C.quest_subtitle": "Gold buys peace"
	"quest.7C1C09F41D6FFF4C.quest_desc": ["Piglins strike anyone who is not wearing gold. Wear it and they leave you alone.", "Drop a gold ingot where one can see it and it stops to pick it up. Throw gold at it and it trades."]
	"quest.191B8593F00B3F7A.title": "A Bastion"
	"quest.191B8593F00B3F7A.quest_subtitle": "A stronghold of gold"
	"quest.191B8593F00B3F7A.quest_desc": ["Bastions hold gold, a great many piglins, and chests worth the trouble.", "Bring a shield and more gold than you think. The template that upgrades diamond to netherite can turn up in their chests."]
	"quest.31F9484F519E46ED.title": "Ancient debris"
	"quest.31F9484F519E46ED.quest_subtitle": "Dark, heavy, and deep"
	"quest.31F9484F519E46ED.quest_desc": ["It hides deep in the rock below the lava and needs a diamond pickaxe.", "Smelt it to scrap."]
	"quest.413E95468D637561.title": "Netherite"
	"quest.413E95468D637561.quest_subtitle": "The top of the ladder"
	"quest.413E95468D637561.quest_desc": ["Four scrap and four gold make one ingot.", "At a smithing table, an ingot and an upgrade template turn diamond gear into netherite. Netherite armour keeps the rot off as gold does."]
	"quest.4DAD69B2010D5E85.title": "The gate ruin"
	"quest.4DAD69B2010D5E85.quest_subtitle": "A ring in the teal forest"
	"quest.4DAD69B2010D5E85.quest_desc": ["Find the warped forest, the teal one. A ring stands in it, within about a mile of the world's middle.", "It cannot be broken, and it will not wake without this world's own key."]
	"quest.07B5127DA531673B.title": "Old halls"
	"quest.07B5127DA531673B.quest_subtitle": "Half-buried, and not empty"
	"quest.07B5127DA531673B.quest_desc": ["Broken halls lie scattered across the wastes and the red forests.", "Their chests hold old things and enchanted books. Take what you can carry."]
	"quest.7F9491C9236F235B.title": "The Netherite Monstrosity"
	"quest.7F9491C9236F235B.quest_subtitle": "A smith that never stopped"
	"quest.7F9491C9236F235B.quest_desc": ["It works a forge in the soul sand valleys, and it hits like a falling building.", "It drops this world's key. The first time your team beats it, everyone on the team gains skill points."]
	"quest.2B156EEB7C1A6EE2.title": "Wake the ring"
	"quest.2B156EEB7C1A6EE2.quest_subtitle": "Key to the keystone"
	"quest.2B156EEB7C1A6EE2.quest_desc": ["Use the key on the keystone. When it lights, everyone on the server gains skill points.", "With Earth's ring lit as well, you can walk home."]
	"quest.51FB851648C16C6D.title": "A Nether Fortress"
	"quest.51FB851648C16C6D.quest_subtitle": "Long bridges of dark brick"
	"quest.51FB851648C16C6D.quest_desc": ["Blazes spawn in fortresses, and so do wither skeletons.", "Bring fire resistance, a bow, and a way out."]
	"quest.0D96F37AEBC7B1E3.title": "Blaze rods"
	"quest.0D96F37AEBC7B1E3.quest_subtitle": "Fuel, brewing, and more"
	"quest.0D96F37AEBC7B1E3.quest_desc": ["Blazes drop rods. Keep a few: Create's blaze burner is made from a blaze and needs netherrack to hold it."]
	"quest.2C0A43DAD9B7C8BF.title": "The Wither"
	"quest.2C0A43DAD9B7C8BF.quest_subtitle": "Optional, and it fights back from range"
	"quest.2C0A43DAD9B7C8BF.quest_desc": ["Wither skeletons drop skulls, rarely. Three skulls on a T of four soul sand call it.", "Fight it in a tunnel with a low roof. Bring a shield, and milk to cure the withering.", "The first time your team beats it, everyone on the team gains skill points."]
	"quest.77D678A9C6557137.title": "Ignis"
	"quest.77D678A9C6557137.quest_subtitle": "Optional, and no easier"
	"quest.77D678A9C6557137.quest_desc": ["A second fire fights in an arena of its own, somewhere in this world.", "The first time your team beats it, everyone on the team gains skill points."]
	"chapter.504C0902F6F03067.title": "The Belt"
	"chapter.504C0902F6F03067.chapter_subtitle": ["Thirty-two thousand blocks south. No floor."]
	"quest.0A179F942C41A99E.title": "The longest flight"
	"quest.0A179F942C41A99E.quest_subtitle": "Thirty-two thousand blocks, south"
	"quest.0A179F942C41A99E.quest_desc": ["The End is the farthest world yet, about thirty-two thousand blocks south of Earth. Its air is fine.", "Plan the trip in fuel and food."]
	"quest.72C5BFD6CA1681A1.title": "Landing on the Belt"
	"quest.72C5BFD6CA1681A1.quest_subtitle": "Islands of pale stone, hung in the dark"
	"quest.72C5BFD6CA1681A1.quest_desc": ["A ship comes down over empty air, a little way from the middle. Fly in toward the bright island.", "Landing here earns a skill point, once."]
	"quest.67F1248349F02855.title": "No floor"
	"quest.67F1248349F02855.quest_subtitle": "Falling out leads back to space"
	"quest.67F1248349F02855.quest_desc": ["Step off an island and you drift down slowly, taking no harm. Past the bottom of the world you are carried back into space beside the planet, with nothing lost.", "Wings are the way to cross the gaps."]
	"quest.14448F103F926A3F.title": "The Ender Dragon"
	"quest.14448F103F926A3F.quest_subtitle": "Ten pillars, each with a crystal"
	"quest.14448F103F926A3F.quest_desc": ["The crystals on the pillars heal her. Break them first.", "Her head takes a full hit and the rest of her takes a quarter. The first time your team beats her, everyone on the team gains skill points."]
	"quest.1FDC801BA19519D8.title": "The way out"
	"quest.1FDC801BA19519D8.quest_subtitle": "Her portal becomes a gate"
	"quest.1FDC801BA19519D8.quest_desc": ["When she falls, the portal in the middle of the arena wakes. Step into it and pick where to go.", "When it lights, everyone on the server gains skill points. It joins the gates you have already lit."]
	"quest.4E99C6C039EF026D.title": "A small gateway"
	"quest.4E99C6C039EF026D.quest_subtitle": "A short road to the outer islands"
	"quest.4E99C6C039EF026D.quest_desc": ["Each time she falls, a small gateway opens on a ring around the arena. Throw an ender pearl at one and it carries you a long way out."]
	"quest.56E1AB25AAE0E904.title": "An End city"
	"quest.56E1AB25AAE0E904.quest_subtitle": "Tall towers on the outer islands"
	"quest.56E1AB25AAE0E904.quest_desc": ["Shulkers guard the towers and their chests. A shulker shell makes a shulker box."]
	"quest.285BD7E7DA3D6D16.title": "Wings"
	"quest.285BD7E7DA3D6D16.quest_subtitle": "In a ship, in an item frame"
	"quest.285BD7E7DA3D6D16.quest_desc": ["Some cities have a ship moored beside them. The wings are in its frame.", "They do not carry you into space. The sky still ends at the top of the world."]
	"quest.04D8525A9D1412DE.title": "Shulker shells"
	"quest.04D8525A9D1412DE.quest_subtitle": "Boxes that keep what is inside"
	"quest.04D8525A9D1412DE.quest_desc": ["Two shells and a chest make a shulker box."]
	"chapter.4FC237B40A7ED679.title": "Gear and Growth"
	"chapter.4FC237B40A7ED679.chapter_subtitle": ["What you wear, earn and choose."]
	"quest.5358EC9AFB8263A5.title": "Armour counts"
	"quest.5358EC9AFB8263A5.quest_subtitle": "Any armour feeds your numbers"
	"quest.5358EC9AFB8263A5.quest_desc": ["Iron, diamond, gold and any other mod's armour all feed your numbers: Armor, Magic Resist and Health.", "Open the sheet (H) to see what each piece gives."]
	"quest.55A609B2C0273FF0.title": "Enchanting"
	"quest.55A609B2C0273FF0.quest_subtitle": "It counts toward your numbers"
	"quest.55A609B2C0273FF0.quest_desc": ["Enchant something. What it adds is listed on its tooltip, and it counts toward your numbers.", "Bookshelves around the table make it stronger. Lapis is the cost."]
	"quest.757321B50E1B3012.title": "Tomes"
	"quest.757321B50E1B3012.quest_subtitle": "Unmake an enchantment, or move it"
	"quest.757321B50E1B3012.quest_desc": ["A Tome of Scrapping wipes an item's enchantments at an anvil. A Tome of Extraction moves them onto a book in a crafting grid.", "Both are a book, lapis and a pinch of stone: flint for scrapping, an amethyst shard for extraction."]
	"quest.3FA0DF670A7A9B34.title": "A key for each ability"
	"quest.3FA0DF670A7A9B34.quest_subtitle": "Z, X and the side buttons"
	"quest.3FA0DF670A7A9B34.quest_desc": ["Some items carry an ability. Every place you wear one has its own key, so two never fire together.", "Z is the legs, X the chest, mouse button 4 the off hand and the relic slot, mouse button 5 the item in your hand.", "Change them in Controls. Hover an item to see its key; its cooldown shows on the item itself."]
	"quest.494C69CF09D79CDC.title": "Skill points"
	"quest.494C69CF09D79CDC.quest_subtitle": "Earned, never farmed"
	"quest.494C69CF09D79CDC.quest_desc": ["Nothing here comes from kills or hours played. Bosses, lit rings and new kinds of place each give points, once.", "Open the web with K. The page \"Runes and Skill Points\" walks through it."]
	"quest.6597430D4FA93FBC.title": "The web"
	"quest.6597430D4FA93FBC.quest_subtitle": "Four directions, no dead ends"
	"quest.6597430D4FA93FBC.quest_desc": ["Power, Fury, Guard and Wayfarer shade into one another. Every node costs a point and must touch one you already hold.", "Change your mind anywhere out of a fight, for twenty levels. Every point comes back."]
	"quest.61DDD3B3B5319005.title": "Firsts"
	"quest.61DDD3B3B5319005.quest_subtitle": "A hundred cities, one point"
	"quest.61DDD3B3B5319005.quest_desc": ["The first time you find each kind of place, you gain a point: a deep city, a mansion, a monument, a fortress, a bastion, and more.", "A second one of the same kind gives nothing, so go somewhere new."]
	"quest.52B80A7ACBC831E3.title": "The rune page"
	"quest.52B80A7ACBC831E3.quest_subtitle": "R"
	"quest.52B80A7ACBC831E3.quest_desc": ["Pick a path, a keystone and two small runes. They change how you fight, not how strong you are.", "Open the page with R. Nothing is kept until you press Save.", "The page \"Runes and Skill Points\" walks through it."]
	"quest.41A77052D72ABFB2.title": "Rune chalk"
	"quest.41A77052D72ABFB2.quest_subtitle": "The price of a change"
	"quest.41A77052D72ABFB2.quest_desc": ["Removing or replacing a rune costs one chalk and a few levels. Filling an empty slot is free.", "Amethyst and calcite make chalk, and both come from geodes."]
	"quest.498ABEBD565DB4A4.title": "More room"
	"quest.498ABEBD565DB4A4.quest_subtitle": "The page grows as you do"
	"quest.498ABEBD565DB4A4.quest_desc": ["Your team's first boss kill or lit ring opens a second path. The next three open the shards, one at a time.", "A locked slot says what opens it."]
	"chapter.6B55D454BF84A675.title": "Together"
	"chapter.6B55D454BF84A675.chapter_subtitle": ["Friends make the road shorter."]
	"quest.7E97FCFC0CB2DC8E.title": "A party"
	"quest.7E97FCFC0CB2DC8E.quest_subtitle": "Friends share a team"
	"quest.7E97FCFC0CB2DC8E.quest_desc": ["Open the team screen from the button beside your inventory, make a party and invite your friends.", "A boss one of you beats counts for all of you, and so do the quests."]
	"quest.18C5623AF0F0B611.title": "Catching up"
	"quest.18C5623AF0F0B611.quest_subtitle": "Join late, miss nothing"
	"quest.18C5623AF0F0B611.quest_desc": ["Join a party and you receive what it already holds: its boss kills and its lit rings.", "The party receives what you hold. Leaving takes nothing back."]
	"quest.777D5103B6FAC0E1.title": "No friendly fire"
	"quest.777D5103B6FAC0E1.quest_subtitle": "Swing wide"
	"quest.777D5103B6FAC0E1.quest_desc": ["Party members cannot hurt each other: not with swords, arrows, fuses or pets.", "Anyone else can, wherever the server allows fighting."]
	"quest.1EFBD4D8CAEACCA9.title": "One book, many hands"
	"quest.1EFBD4D8CAEACCA9.quest_subtitle": "A task done is done for all"
	"quest.1EFBD4D8CAEACCA9.quest_desc": ["A quest one of you finishes counts for the whole party.", "Each of you claims your own rewards."]
	"quest.260259C5187619CB.title": "The map"
	"quest.260259C5187619CB.quest_subtitle": "M"
	"quest.260259C5187619CB.quest_desc": ["Press M for the map: the land you have walked, and the players near you."]
	"quest.5486899F38DD1418.title": "A breath for a friend"
	"quest.5486899F38DD1418.quest_subtitle": "Use a tank on a player"
	"quest.5486899F38DD1418.quest_desc": ["Use an oxygen tank on another player to fill their lungs from it.", "It is a rescue, not a refill: their lungs only, and only as much as they can hold."]
}
